{
  "name": "drivefs-workspace",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run build && node --test tests/test-conformance.mjs tests/test-gdrive.mjs tests/test-microsoft.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint packages tests eslint.config.mjs",
    "format:check": "prettier --check \"packages/*/src/**/*.ts\" \"tests/**/*.mjs\" eslint.config.mjs package.json \"packages/*/package.json\" \"packages/*/tsconfig.json\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0"
  }
}
